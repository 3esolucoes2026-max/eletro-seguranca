{
  "$schema": "https://json-schema.appswithlove.com/easypanel/5.4/schema.json",
  "name": "3e-instalacoes-eletrica",
  "description": "Site institucional 3E - Instalação e Manutenção Elétrica",
  "services": [
    {
      "name": "3e-instalacoes",
      "image": "nginx:1.27-alpine",
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile"
      },
      "deploy": {
        "replicas": 1
      },
      "domains": [],
      "ports": [
        {
          "published": 8080,
          "target": 80,
          "protocol": "tcp"
        }
      ],
      "env": "",
      "mounts": [],
      "healthCheck": {
        "enabled": true,
        "path": "/",
        "port": 80,
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 10
      }
    }
  ]
}
